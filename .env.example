# NikahYuk - Environment Configuration Template
# Salin file ini menjadi .env.local dan isi dengan konfigurasi Supabase & R2 riil Anda

# Supabase Project Configuration (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# URL Publik Aplikasi
NEXT_PUBLIC_APP_URL="https://nikahyuk.pilihmenumu.com"

# Kunci Enkripsi Backup Superadmin (Min 32 karakter)
BACKUP_ENCRYPTION_SECRET="generate-via-openssl-rand-hex-32-for-safe-backup-aes"

# Node Environment (development / production)
NODE_ENV="development"
